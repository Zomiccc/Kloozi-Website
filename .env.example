# Copy to .env.local for local dev. In production set these in Vercel.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Admin panel (/admin) — generate the hash + secret with:
#   npm run admin:password -- "your-strong-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Vercel → Settings → Git → Deploy Hooks (lets "Publish" rebuild the site)
VERCEL_DEPLOY_HOOK_URL=
# Added automatically when a Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
