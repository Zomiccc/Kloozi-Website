{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/signup", "destination": "/early-access", "permanent": false },
    { "source": "/pricing", "destination": "/early-access", "permanent": false },
    { "source": "/careers", "destination": "/about", "permanent": false },
    { "source": "/resources/help-center", "destination": "/contact", "permanent": false },
    { "source": "/resources/api-docs", "destination": "/contact", "permanent": false },
    { "source": "/legal/privacy", "destination": "/privacy", "permanent": true },
    { "source": "/legal/terms", "destination": "/terms", "permanent": true },
    { "source": "/legal/data-deletion", "destination": "/data-deletion", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
